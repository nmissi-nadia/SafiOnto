safi:Enseignement rdf:type owl:Class ;
                  rdfs:subClassOf safi:LieuGéographique ;
                  rdfs:label "Établissement d'Enseignement"@fr .


###  http://ontologie.safi.ma/onto#EntitéSafi
safi:EntitéSafi rdf:type owl:Class ;
                rdfs:comment "Classe racine de toutes les entités de l'ontologie de Safi"@fr ;
                rdfs:label "Entité Safi"@fr .


###  http://ontologie.safi.ma/onto#EntreprisePrivée
safi:EntreprisePrivée rdf:type owl:Class ;
                      rdfs:subClassOf safi:Acteur ;
                      rdfs:label "Entreprise Privée"@fr .


