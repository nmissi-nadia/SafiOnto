safi:EspacePublic rdf:type owl:Class ;
                  rdfs:subClassOf safi:CultureLoisirs ;
                  rdfs:label "Espace Public / Promenade"@fr .


###  http://ontologie.safi.ma/onto#FormationArtisanale
safi:FormationArtisanale rdf:type owl:Class ;
                         rdfs:subClassOf safi:Enseignement ;
                         rdfs:label "Formation Artisanale"@fr .


