@prefix : <http://ontologie.safi.ma/onto#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix safi: <http://ontologie.safi.ma/onto#> .
@prefix schema: <https://schema.org/> .
@base <http://ontologie.safi.ma/onto> .

<http://ontologie.safi.ma/onto> rdf:type owl:Ontology ;
                                 dc:creator "Projet Ontologie Safi" ;
                                 dc:description "Ontologie formelle décrivant les lieux, institutions, services et entités de la ville de Safi"@fr ;
                                 dc:title "Ontologie de la Ville de Safi (Maroc)"@fr ;
                                 owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://ontologie.safi.ma/onto#aConstruitPar
safi:aConstruitPar rdf:type owl:ObjectProperty ;
                   rdfs:domain safi:LieuGéographique ;
                   rdfs:range safi:Acteur ;
                   rdfs:label "a été construit par"@fr .


###  http://ontologie.safi.ma/onto#aSuccédéÀ
safi:aSuccédéÀ rdf:type owl:ObjectProperty ;
               rdfs:domain safi:LieuGéographique ;
               rdfs:range safi:LieuGéographique ;
               rdfs:label "a succédé à (sur le même site)"@fr .


###  http://ontologie.safi.ma/onto#aÉtéRestauréPar
safi:aÉtéRestauréPar rdf:type owl:ObjectProperty ;
                     rdfs:domain safi:LieuGéographique ;
                     rdfs:range safi:Acteur ;
                     rdfs:label "a été restauré par"@fr .


###  http://ontologie.safi.ma/onto#estLiéHistoriquementÀ
safi:estLiéHistoriquementÀ rdf:type owl:ObjectProperty ,
                                    owl:SymmetricProperty ;
                           rdfs:domain safi:LieuGéographique ;
                           rdfs:range safi:LieuGéographique ;
                           rdfs:label "est lié historiquement à"@fr .


###  http://ontologie.safi.ma/onto#estPartieIntégranteDe
safi:estPartieIntégranteDe rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf safi:estLiéHistoriquementÀ ;
                           rdfs:domain safi:LieuGéographique ;
                           rdfs:range safi:LieuGéographique ;
                           rdfs:label "est partie intégrante de"@fr .


###  http://ontologie.safi.ma/onto#estSituéDans
safi:estSituéDans rdf:type owl:ObjectProperty ;
                  rdfs:domain safi:LieuGéographique ;
                  rdfs:range safi:QuartierZone ;
                  rdfs:label "est situé dans"@fr .


###  http://ontologie.safi.ma/onto#gèreParInstitution
safi:gèreParInstitution rdf:type owl:ObjectProperty ;
                        rdfs:domain safi:LieuGéographique ;
                        rdfs:range safi:Acteur ;
                        rdfs:label "géré par institution"@fr .


###  http://ontologie.safi.ma/onto#offre
safi:offre rdf:type owl:ObjectProperty ;
           rdfs:domain safi:LieuGéographique ;
           rdfs:range safi:Service ;
           rdfs:label "offre"@fr .


#################################################################
#    Data properties
#################################################################

###  http://ontologie.safi.ma/onto#adresse
safi:adresse rdf:type owl:DatatypeProperty ;
             rdfs:domain safi:LieuGéographique ;
             rdfs:range xsd:string ;
             rdfs:label "adresse"@fr .


###  http://ontologie.safi.ma/onto#annéeClassementUNESCO
safi:annéeClassementUNESCO rdf:type owl:DatatypeProperty ;
                           rdfs:domain safi:LieuGéographique ;
                           rdfs:range xsd:gYear ;
                           rdfs:label "année classement UNESCO"@fr .


###  http://ontologie.safi.ma/onto#annéeConstruction
safi:annéeConstruction rdf:type owl:DatatypeProperty ;
                       rdfs:domain safi:LieuGéographique ;
                       rdfs:range xsd:string ;
                       rdfs:label "année de construction"@fr .


###  http://ontologie.safi.ma/onto#classéUNESCO
safi:classéUNESCO rdf:type owl:DatatypeProperty ;
                  rdfs:domain safi:LieuGéographique ;
                  rdfs:range xsd:boolean ;
                  rdfs:label "classé UNESCO"@fr .


###  http://ontologie.safi.ma/onto#cuisineProposée
safi:cuisineProposée rdf:type owl:DatatypeProperty ;
                     rdfs:domain safi:Restauration ;
                     rdfs:range xsd:string ;
                     rdfs:label "type de cuisine proposée"@fr .


###  http://ontologie.safi.ma/onto#dernièreRestauration
safi:dernièreRestauration rdf:type owl:DatatypeProperty ;
                          rdfs:domain safi:LieuGéographique ;
                          rdfs:range xsd:string ;
                          rdfs:label "dernière restauration"@fr .


###  http://ontologie.safi.ma/onto#horaires
safi:horaires rdf:type owl:DatatypeProperty ;
              rdfs:domain safi:LieuGéographique ;
              rdfs:range xsd:string ;
              rdfs:label "horaires d'ouverture"@fr .


###  http://ontologie.safi.ma/onto#latitude
safi:latitude rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf geo:lat ;
              rdfs:domain safi:LieuGéographique ;
              rdfs:range xsd:decimal ;
              rdfs:label "latitude"@fr .


###  http://ontologie.safi.ma/onto#livraison
safi:livraison rdf:type owl:DatatypeProperty ;
               rdfs:domain safi:Restauration ;
               rdfs:range xsd:boolean ;
               rdfs:label "livraison disponible"@fr .


###  http://ontologie.safi.ma/onto#longitude
safi:longitude rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf geo:long ;
               rdfs:domain safi:LieuGéographique ;
               rdfs:range xsd:decimal ;
               rdfs:label "longitude"@fr .


###  http://ontologie.safi.ma/onto#noteMoyenne
safi:noteMoyenne rdf:type owl:DatatypeProperty ;
                 rdfs:domain safi:Restauration ;
                 rdfs:range xsd:string ;
                 rdfs:label "note moyenne (avis)"@fr .


###  http://ontologie.safi.ma/onto#prixMoyenNuit
safi:prixMoyenNuit rdf:type owl:DatatypeProperty ;
                   rdfs:domain safi:Hébergement ;
                   rdfs:range xsd:string ;
                   rdfs:label "prix moyen par nuit (DH)"@fr .


###  http://ontologie.safi.ma/onto#prixMoyenRepas
safi:prixMoyenRepas rdf:type owl:DatatypeProperty ;
                    rdfs:domain safi:Restauration ;
                    rdfs:range xsd:string ;
                    rdfs:label "prix moyen par repas (DH)"@fr .


###  http://ontologie.safi.ma/onto#siteWeb
safi:siteWeb rdf:type owl:DatatypeProperty ;
             rdfs:domain safi:LieuGéographique ;
             rdfs:range xsd:anyURI ;
             rdfs:label "site web"@fr .


###  http://ontologie.safi.ma/onto#spécialités
safi:spécialités rdf:type owl:DatatypeProperty ;
                 rdfs:domain safi:LieuGéographique ;
                 rdfs:range xsd:string ;
                 rdfs:label "spécialités / services"@fr .


###  http://ontologie.safi.ma/onto#statutNational
safi:statutNational rdf:type owl:DatatypeProperty ;
                    rdfs:domain safi:LieuGéographique ;
                    rdfs:range xsd:string ;
                    rdfs:label "statut national"@fr .


###  http://ontologie.safi.ma/onto#typeGestion
safi:typeGestion rdf:type owl:DatatypeProperty ;
                 rdfs:domain safi:LieuGéographique ;
                 rdfs:range xsd:string ;
                 rdfs:label "type de gestion (public/privé/mixte)"@fr .


###  http://ontologie.safi.ma/onto#téléphone
safi:téléphone rdf:type owl:DatatypeProperty ;
               rdfs:domain safi:LieuGéographique ;
               rdfs:range xsd:string ;
               rdfs:label "numéro de téléphone"@fr .


###  http://ontologie.safi.ma/onto#étoiles
safi:étoiles rdf:type owl:DatatypeProperty ;
             rdfs:domain safi:Hébergement ;
             rdfs:range xsd:integer ;
             rdfs:label "nombre d'étoiles"@fr .


###  http://www.w3.org/2003/01/geo/wgs84_pos#lat
geo:lat rdf:type owl:DatatypeProperty .


###  http://www.w3.org/2003/01/geo/wgs84_pos#long
geo:long rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://ontologie.safi.ma/onto#Acteur
safi:Acteur rdf:type owl:Class ;
            rdfs:subClassOf safi:EntitéSafi ;
            rdfs:comment "Personne morale ou physique impliquée dans la construction, gestion ou restauration d'un lieu"@fr ;
            rdfs:label "Acteur"@fr .


###  http://ontologie.safi.ma/onto#Banque
safi:Banque rdf:type owl:Class ;
            rdfs:subClassOf safi:ServiceInstitution ;
            rdfs:label "Banque"@fr .


###  http://ontologie.safi.ma/onto#Bibliothèque
safi:Bibliothèque rdf:type owl:Class ;
                  rdfs:subClassOf safi:CultureLoisirs .


###  http://ontologie.safi.ma/onto#CaféRestaurant
safi:CaféRestaurant rdf:type owl:Class ;
                    rdfs:subClassOf safi:Restauration ;
                    rdfs:label "Café / Restaurant"@fr .


###  http://ontologie.safi.ma/onto#CentreArts
safi:CentreArts rdf:type owl:Class ;
                rdfs:subClassOf safi:CultureLoisirs ;
                rdfs:label "Centre Arts et Culture"@fr .


###  http://ontologie.safi.ma/onto#CollectifArtisanal
safi:CollectifArtisanal rdf:type owl:Class ;
                        rdfs:subClassOf safi:Acteur ;
                        rdfs:label "Collectif Artisanal"@fr .


###  http://ontologie.safi.ma/onto#Collège
safi:Collège rdf:type owl:Class ;
             rdfs:subClassOf safi:Enseignement ;
             rdfs:label "Collège"@fr .


###  http://ontologie.safi.ma/onto#Commerce
safi:Commerce rdf:type owl:Class ;
              rdfs:subClassOf safi:LieuGéographique ;
              rdfs:label "Commerce"@fr .


###  http://ontologie.safi.ma/onto#ConservatoireMusique
safi:ConservatoireMusique rdf:type owl:Class ;
                          rdfs:subClassOf safi:Enseignement ;
                          rdfs:label "Conservatoire de Musique"@fr .


###  http://ontologie.safi.ma/onto#CultureLoisirs
safi:CultureLoisirs rdf:type owl:Class ;
                    rdfs:subClassOf safi:LieuGéographique ;
                    rdfs:label "Culture et Loisirs"@fr .


