safi:HôpitalPrivé rdf:type owl:Class ;
                  rdfs:subClassOf safi:Santé ;
                  rdfs:label "Hôpital Privé"@fr .


###  http://ontologie.safi.ma/onto#HôpitalPublic
safi:HôpitalPublic rdf:type owl:Class ;
                   rdfs:subClassOf safi:Santé ;
