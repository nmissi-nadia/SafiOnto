safi:Forteresse rdf:type owl:Class ;
                rdfs:subClassOf safi:PatrimoineMilitaire ;
                rdfs:label "Forteresse"@fr .


###  http://ontologie.safi.ma/onto#GareFerroviaire
safi:GareFerroviaire rdf:type owl:Class ;
                     rdfs:subClassOf safi:Transport ;
                     rdfs:label "Gare Ferroviaire"@fr .


###  http://ontologie.safi.ma/onto#GareRoutière
safi:GareRoutière rdf:type owl:Class ;
                  rdfs:subClassOf safi:Transport .


###  http://ontologie.safi.ma/onto#GrandeSurface
safi:GrandeSurface rdf:type owl:Class ;
