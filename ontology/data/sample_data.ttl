@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix safionto: <http://example.org/safionto/> .

# --- Arborescence des Classes (Basée sur l'image Protégé) ---
safionto:Place rdf:type owl:Class .
safionto:Historical_Place rdfs:subClassOf safionto:Place .
safionto:Cultural_Place rdfs:subClassOf safionto:Place .
safionto:Commercial_Place rdfs:subClassOf safionto:Place .

safionto:Fort rdfs:subClassOf safionto:Historical_Place .
safionto:Pottery_Workshop rdfs:subClassOf safionto:Cultural_Place .
safionto:Hotel rdfs:subClassOf safionto:Commercial_Place .

# --- Data Properties ---
safionto:creationDate rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
safionto:description rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
safionto:imageURL rdf:type owl:DatatypeProperty ; rdfs:range xsd:anyURI .
safionto:latitude rdf:type owl:DatatypeProperty ; rdfs:range xsd:float .
safionto:longitude rdf:type owl:DatatypeProperty ; rdfs:range xsd:float .
safionto:placeName rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .

# --- Données (Ksar El Bahar) ---
safionto:KsarElBahar rdf:type safionto:Fort ;
    safionto:placeName "Ksar El Bahar" ;
    safionto:creationDate "1508" ;
    safionto:description "Le Ksar El Bahar (Château de la mer) est une forteresse portugaise du XVIe siècle située sur le front de mer de Safi." ;
    safionto:imageURL "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Ksar_el-Bahr.jpg/640px-Ksar_el-Bahr.jpg" ;
    safionto:latitude 32.298 ;
    safionto:longitude -9.243 .

# --- Données (Colline des Potiers) ---
safionto:CollinePotiers rdf:type safionto:Pottery_Workshop ;
    safionto:placeName "Colline des Potiers" ;
    safionto:creationDate "1800" ;
    safionto:description "Le centre historique de l'artisanat de la poterie traditionnelle de Safi." ;
    safionto:imageURL "https://www.moroccopedia.com/wp-content/uploads/2012/12/Safi-Pottery.jpg" ;
    safionto:latitude 32.302 ;
    safionto:longitude -9.231 .

# --- Données (Hôtel Atlantique) ---
safionto:Hotel_Atlantique rdf:type safionto:Hotel ;
    safionto:placeName "Hôtel Atlantique" ;
    safionto:creationDate "1930" ;
    safionto:description "Un hôtel emblématique de Safi, témoignage de l'architecture coloniale." ;
    safionto:imageURL "https://upload.wikimedia.org/wikipedia/commons/thumb/1/1a/Hotel_Atlantique_Safi.jpg/640px-Hotel_Atlantique_Safi.jpg" ;
    safionto:latitude 32.305 ;
    safionto:longitude -9.240 .
